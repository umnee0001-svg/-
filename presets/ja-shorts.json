{
  "$schema": "../preset.schema.json",
  "name": "ja-shorts",
  "output": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "max_duration": 59,
    "crf": 20
  },
  "source": {
    "fit": "crop",
    "crop_anchor": "center",
    "speed": 1.0
  },
  "subtitle": {
    "enabled": true,
    "mode": "auto",
    "language": "ja",
    "whisper_model": "small",
    "font_name": "Noto Sans CJK JP",
    "font_size": 78,
    "bold": true,
    "primary_color": "#FFFFFF",
    "outline_color": "#000000",
    "outline": 6,
    "shadow": 2,
    "border_style": 1,
    "alignment": 2,
    "margin_v": 430,
    "max_chars_per_line": 12,
    "max_lines": 2
  },
  "bgm": { "enabled": false },
  "watermark": { "enabled": false },
  "hook": {
    "enabled": false,
    "text": "",
    "duration": 3.0,
    "font_size": 92,
    "color": "#FFE600",
    "outline_color": "#000000",
    "outline": 8,
    "box": false,
    "position_y": 0.14
  }
}

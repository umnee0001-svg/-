{
  "$schema": "../preset.schema.json",
  "name": "longform",
  "output": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "max_duration": null,
    "crf": 20,
    "x264_preset": "medium",
    "filename_template": "{date}_{preset}_{slug}.mp4"
  },
  "source": {
    "fit": "pad",
    "pad_color": "#000000",
    "trim": {
      "start": null,
      "end": null
    },
    "speed": 1.0
  },
  "subtitle": {
    "enabled": true,
    "mode": "auto",
    "language": "ko",
    "whisper_model": "small",
    "font_size": 58,
    "bold": true,
    "primary_color": "#FFFFFF",
    "outline_color": "#000000",
    "outline": 4,
    "shadow": 1,
    "border_style": 1,
    "alignment": 2,
    "margin_v": 70,
    "margin_h": 160,
    "max_chars_per_line": 30,
    "max_lines": 2
  },
  "bgm": {
    "enabled": false,
    "volume_db": -24
  },
  "watermark": {
    "enabled": false,
    "scale": 0.08
  },
  "hook": {
    "enabled": false,
    "font_size": 84,
    "position_y": 0.12
  }
}

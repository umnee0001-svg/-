# 결과물
output/*
!output/.gitkeep

# 사용자 자산 (용량이 크고 저작권이 걸려 있어 커밋하지 않습니다)
assets/fonts/*
!assets/fonts/.gitkeep
assets/bgm/*
!assets/bgm/.gitkeep
assets/watermark/*
!assets/watermark/.gitkeep
samples/*
!samples/.gitkeep

# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# 업로더 로컬 설정/상태 (MultiLogin 프로필 ID 등이 들어가므로 커밋하지 않습니다)
channels.json
settings.json
*.db
*.db-wal
*.db-shm
